{
    "name": "danielmrdev/laravel-spanish-validator",
    "description": "Laravel validator for spanish stuff: NIF, NIE, CIF, NSS, IBAN, Postal Code, Phone numbers",
    "keywords": [
        "laravel validation rules",
        "laravel",
        "laravel package",
        "laravel validator",
        "spanish validator",
        "nif",
        "nie",
        "cif"
    ],
    "homepage": "https://github.com/danielmrdev/laravel-spanish-validator",
    "version": "2.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel MR",
            "email": "dev@danielmr.dev",
            "homepage": "https://danielmr.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "globalcitizen/php-iban": "^4.2.3",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Danielmrdev\\SpanishValidator\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Danielmrdev\\SpanishValidator\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Danielmrdev\\SpanishValidator\\SpanishValidatorServiceProvider"
            ],
            "aliases": {
                "SpanishValidator": "Danielmrdev\\SpanishValidator\\Facades\\SpanishValidator"
            }
        }
    }
}
